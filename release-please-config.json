{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "tag-separator": "/",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Added"
    },
    {
      "type": "fix",
      "section": "Fixed"
    },
    {
      "type": "perf",
      "section": "Performance"
    },
    {
      "type": "revert",
      "section": "Reverted"
    },
    {
      "type": "docs",
      "section": "Documentation",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    },
    {
      "type": "refactor",
      "section": "Refactoring",
      "hidden": true
    },
    {
      "type": "build",
      "section": "Build",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "CI",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Chores",
      "hidden": true
    }
  ],
  "packages": {
    ".": {
      "package-name": "ragite-demo",
      "component": "ragite-demo",
      "changelog-path": "CHANGELOG.md",
      "version-file": "version.txt",
      "initial-version": "0.1.0"
    }
  }
}
